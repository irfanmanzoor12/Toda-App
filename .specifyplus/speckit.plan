## Component Definitions

### COMP-001: Task Service (Enhanced)

**Specification Reference:** REQ-002, REQ-003, REQ-004, REQ-005, REQ-006

**Technology Stack:**
- Python 3.11+
- FastAPI 0.104+
- SQLAlchemy 2.0+
- Dapr SDK (Python)
- PostgreSQL

**Responsibilities:**
- Task CRUD operations (existing + enhanced)
- Priority management
- Tag management
- Due date management
- Full-text search
- Event publishing to Kafka via Dapr Pub/Sub

**API Endpoints:**

```yaml
# Existing endpoints (enhanced)
GET /api/todos:
  description: "List user's tasks with filters"
  query_params:
    status: "pending | completed (optional)"
    priority: "low | medium | high | critical (optional)"
    tags: "array of tag names (optional)"
    due_before: "ISO 8601 timestamp (optional)"
    due_after: "ISO 8601 timestamp (optional)"
    limit: "integer (default: 100)"
    offset: "integer (default: 0)"
  response:
    type: "array of Task objects"
    includes:
      - "task metadata"
      - "priority"
      - "tags"
      - "due_date"
      - "recurrence_pattern (if any)"

POST /api/todos:
  description: "Create new task"
  request_body:
    title: "string (required)"
    description: "string (optional)"
    priority: "enum (low, medium, high, critical) (default: medium)"
    tags: "array of strings (optional)"
    due_date: "ISO 8601 timestamp (optional)"
    reminder_schedule: "array of reminder times (optional, e.g., ['1h', '1d'])"
  response:
    type: "Task object"
  side_effects:
    - "Publishes task.created event to Kafka"

PUT /api/todos/{id}:
  description: "Update existing task"
  request_body:
    title: "string (optional)"
    description: "string (optional)"
    priority: "enum (optional)"
    tags: "array of strings (optional)"
    due_date: "ISO 8601 timestamp (optional)"
  response:
    type: "Task object"
  side_effects:
    - "Publishes task.updated event with diff"

DELETE /api/todos/{id}:
  description: "Delete task (soft delete)"
  response:
    status: 204
  side_effects:
    - "Sets deleted_at timestamp"
    - "Publishes task.deleted event"

POST /api/todos/{id}/complete:
  description: "Mark task as completed"
  response:
    type: "Task object"
  side_effects:
    - "Sets completed_at timestamp"
    - "Publishes task.completed event"

# New endpoints for Phase V
GET /api/todos/search:
  description: "Full-text search tasks"
  query_params:
    q: "string (search query, required)"
    status: "pending | completed (optional)"
    priority: "low | medium | high | critical (optional)"
    tags: "array of tag names (optional)"
    due_before: "ISO 8601 timestamp (optional)"
    due_after: "ISO 8601 timestamp (optional)"
    sort_by: "relevance | due_date | priority | created_at (default: relevance)"
    limit: "integer (default: 50)"
  response:
    type: "array of Task objects with relevance score"

POST /api/todos/{id}/tags:
  description: "Add tags to task"
  request_body:
    tags: "array of strings (required)"
  response:
    type: "Task object with updated tags"
  side_effects:
    - "Creates new tags if they don't exist"
    - "Publishes task.tagged event"

DELETE /api/todos/{id}/tags/{tag_name}:
  description: "Remove tag from task"
  response:
    type: "Task object"
  side_effects:
    - "Publishes task.untagged event"

GET /api/tags:
  description: "List all user's tags with usage count"
  query_params:
    sort_by: "usage | name (default: usage)"
    limit: "integer (default: 50)"
  response:
    type: "array of Tag objects with count"

PUT /api/todos/{id}/priority:
  description: "Update task priority"
  request_body:
    priority: "enum (low, medium, high, critical)"
  response:
    type: "Task object"
  side_effects:
    - "Publishes task.priority_changed event"

PUT /api/todos/{id}/due-date:
  description: "Set or update due date"
  request_body:
    due_date: "ISO 8601 timestamp (required)"
    reminder_schedule: "array of reminder times (optional)"
  response:
    type: "Task object"
  side_effects:
    - "Publishes task.due_date_set event"
    - "Schedules reminders if specified"
```

**Database Schema Changes:**

```sql
-- Migration 001: Add priority column
ALTER TABLE todo ADD COLUMN priority VARCHAR(20) DEFAULT 'medium';
ALTER TABLE todo ADD CONSTRAINT check_priority
  CHECK (priority IN ('low', 'medium', 'high', 'critical'));

-- Migration 002: Add due_date and reminder columns
ALTER TABLE todo ADD COLUMN due_date TIMESTAMP WITH TIME ZONE;
ALTER TABLE todo ADD COLUMN reminder_schedule JSONB;

-- Migration 003: Add soft delete
ALTER TABLE todo ADD COLUMN deleted_at TIMESTAMP WITH TIME ZONE;
CREATE INDEX idx_todo_deleted_at ON todo(deleted_at) WHERE deleted_at IS NULL;

-- Migration 004: Add full-text search
ALTER TABLE todo ADD COLUMN search_vector tsvector;
CREATE INDEX idx_todo_search ON todo USING GIN(search_vector);

-- Trigger to auto-update search_vector
CREATE FUNCTION todo_search_trigger() RETURNS trigger AS $$
BEGIN
  NEW.search_vector :=
    setweight(to_tsvector('english', COALESCE(NEW.title, '')), 'A') ||
    setweight(to_tsvector('english', COALESCE(NEW.description, '')), 'B');
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER todo_search_update
  BEFORE INSERT OR UPDATE ON todo
  FOR EACH ROW EXECUTE FUNCTION todo_search_trigger();

-- Migration 005: Create tags table
CREATE TABLE tags (
  id SERIAL PRIMARY KEY,
  name VARCHAR(50) NOT NULL,
  user_id VARCHAR(255) NOT NULL,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  UNIQUE(name, user_id)
);
CREATE INDEX idx_tags_user_id ON tags(user_id);

-- Migration 006: Create task_tags junction table
CREATE TABLE task_tags (
  task_id INTEGER NOT NULL REFERENCES todo(id) ON DELETE CASCADE,
  tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  PRIMARY KEY (task_id, tag_id)
);
CREATE INDEX idx_task_tags_task_id ON task_tags(task_id);
CREATE INDEX idx_task_tags_tag_id ON task_tags(tag_id);
```

**Event Publishing Implementation:**

```python
# backend/src/events/publisher.py
import httpx
from datetime import datetime
from typing import Dict, Any

class EventPublisher:
    def __init__(self, dapr_port: int = 3500):
        self.dapr_url = f"http://localhost:{dapr_port}/v1.0/publish"
        self.pubsub_name = "kafka-pubsub"

    async def publish_event(self, topic: str, event_type: str, data: Dict[str, Any]):
        """Publish event to Kafka via Dapr Pub/Sub"""
        event = {
            "event_type": event_type,
            "timestamp": datetime.utcnow().isoformat(),
            "data": data
        }

        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{self.dapr_url}/{self.pubsub_name}/{topic}",
                json=event,
                timeout=5.0
            )
            response.raise_for_status()

    async def publish_task_created(self, task: Task, user_id: str):
        await self.publish_event(
            topic="task-events",
            event_type="task.created",
            data={
                "task_id": task.id,
                "user_id": user_id,
                "title": task.title,
                "description": task.description,
                "priority": task.priority,
                "tags": [tag.name for tag in task.tags],
                "due_date": task.due_date.isoformat() if task.due_date else None,
                "created_at": task.created_at.isoformat()
            }
        )

    async def publish_task_updated(self, task_id: int, user_id: str, changes: Dict):
        await self.publish_event(
            topic="task-events",
            event_type="task.updated",
            data={
                "task_id": task_id,
                "user_id": user_id,
                "changes": changes,
                "updated_at": datetime.utcnow().isoformat()
            }
        )
```

