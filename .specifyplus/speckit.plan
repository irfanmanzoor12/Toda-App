### COMP-008: Frontend Enhancements

**Specification Reference:** REQ-002, REQ-003, REQ-004, REQ-005

**New React Components:**

```typescript
// frontend/components/TaskPriority.tsx
export function TaskPriority({
  taskId,
  priority
}: {
  taskId: number;
  priority: 'low' | 'medium' | 'high' | 'critical';
}) {
  const [currentPriority, setCurrentPriority] = useState(priority);

  const updatePriority = async (newPriority: string) => {
    await apiCall(`/api/todos/${taskId}/priority`, {
      method: 'PUT',
      body: JSON.stringify({ priority: newPriority })
    });
    setCurrentPriority(newPriority as any);
  };

  return (
    <select value={currentPriority} onChange={(e) => updatePriority(e.target.value)}>
      <option value="low">Low</option>
      <option value="medium">Medium</option>
      <option value="high">High</option>
      <option value="critical">Critical</option>
    </select>
  );
}

// frontend/components/TaskTags.tsx
export function TaskTags({ taskId, tags }: { taskId: number; tags: string[] }) {
  const [tagInput, setTagInput] = useState('');
  const [currentTags, setCurrentTags] = useState(tags);

  const addTag = async () => {
    await apiCall(`/api/todos/${taskId}/tags`, {
      method: 'POST',
      body: JSON.stringify({ tags: [tagInput] })
    });
    setCurrentTags([...currentTags, tagInput]);
    setTagInput('');
  };

  const removeTag = async (tagName: string) => {
    await apiCall(`/api/todos/${taskId}/tags/${tagName}`, {
      method: 'DELETE'
    });
    setCurrentTags(currentTags.filter(t => t !== tagName));
  };

  return (
    <div className="tags">
      {currentTags.map(tag => (
        <span key={tag} className="tag">
          #{tag}
          <button onClick={() => removeTag(tag)}>×</button>
        </span>
      ))}
      <input
        value={tagInput}
        onChange={(e) => setTagInput(e.target.value)}
        onKeyPress={(e) => e.key === 'Enter' && addTag()}
        placeholder="Add tag..."
      />
    </div>
  );
}

// frontend/components/TaskSearch.tsx
export function TaskSearch() {
  const [query, setQuery] = useState('');
  const [filters, setFilters] = useState({});
  const [results, setResults] = useState([]);

  const search = async () => {
    const params = new URLSearchParams({ q: query, ...filters });
    const data = await apiCall(`/api/todos/search?${params}`);
    setResults(data);
  };

  return (
    <div className="task-search">
      <input
        type="text"
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Search tasks..."
      />
      {/* Filter panel */}
      <TaskSearchFilters filters={filters} setFilters={setFilters} />
      <button onClick={search}>Search</button>
      <TaskSearchResults results={results} />
    </div>
  );
}

// frontend/components/DueDatePicker.tsx
export function DueDatePicker({ taskId, currentDueDate }: { taskId: number; currentDueDate?: string }) {
  const [dueDate, setDueDate] = useState(currentDueDate);
  const [reminders, setReminders] = useState(['1h']);

  const saveDueDate = async () => {
    await apiCall(`/api/todos/${taskId}/due-date`, {
      method: 'PUT',
      body: JSON.stringify({
        due_date: dueDate,
        reminder_schedule: reminders
      })
    });
  };

  return (
    <div className="due-date-picker">
      <input
        type="datetime-local"
        value={dueDate}
        onChange={(e) => setDueDate(e.target.value)}
      />
      <ReminderSchedulePicker reminders={reminders} setReminders={setReminders} />
      <button onClick={saveDueDate}>Save</button>
    </div>
  );
}
```

