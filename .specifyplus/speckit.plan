### COMP-004: MCP Server (Enhanced)

**Specification Reference:** REQ-013

**New MCP Tools:**

```typescript
// chatbot/mcp-server/src/tools.ts

export const NEW_TOOLS = [
  {
    name: "add_recurring_task",
    description: "Create a task with recurrence pattern",
    inputSchema: {
      type: "object",
      properties: {
        title: { type: "string", description: "Task title" },
        description: { type: "string", description: "Task description" },
        priority: {
          type: "string",
          enum: ["low", "medium", "high", "critical"],
          default: "medium"
        },
        recurrence: {
          type: "object",
          properties: {
            frequency: {
              type: "string",
              enum: ["daily", "weekly", "monthly", "custom"]
            },
            interval: { type: "number", default: 1 },
            end_date: { type: "string", format: "date-time" },
            max_occurrences: { type: "number" }
          },
          required: ["frequency"]
        }
      },
      required: ["title", "recurrence"]
    }
  },

  {
    name: "set_due_date",
    description: "Set due date and reminders for a task",
    inputSchema: {
      type: "object",
      properties: {
        task_id: { type: "number" },
        due_date: { type: "string", format: "date-time" },
        reminder_schedule: {
          type: "array",
          items: { type: "string" },
          description: "e.g., ['1h', '1d', '1w']"
        }
      },
      required: ["task_id", "due_date"]
    }
  },

  {
    name: "search_tasks",
    description: "Search tasks with filters",
    inputSchema: {
      type: "object",
      properties: {
        query: { type: "string", description: "Search text" },
        status: { type: "string", enum: ["pending", "completed"] },
        priority: { type: "string", enum: ["low", "medium", "high", "critical"] },
        tags: { type: "array", items: { type: "string" } },
        due_before: { type: "string", format: "date-time" },
        due_after: { type: "string", format: "date-time" }
      },
      required: ["query"]
    }
  },

  {
    name: "add_tags",
    description: "Add tags to a task",
    inputSchema: {
      type: "object",
      properties: {
        task_id: { type: "number" },
        tags: { type: "array", items: { type: "string" } }
      },
      required: ["task_id", "tags"]
    }
  },

  {
    name: "set_priority",
    description: "Set task priority",
    inputSchema: {
      type: "object",
      properties: {
        task_id: { type: "number" },
        priority: { type: "string", enum: ["low", "medium", "high", "critical"] }
      },
      required: ["task_id", "priority"]
    }
  }
];

// Tool execution via Dapr service invocation
async function executeAddRecurringTask(args: any, userId: string) {
  const daprUrl = `http://localhost:3500/v1.0/invoke/task-service/method/api/todos`;

  // Create base task
  const taskResponse = await fetch(daprUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${userId}`
    },
    body: JSON.stringify({
      title: args.title,
      description: args.description,
      priority: args.priority || 'medium'
    })
  });

  const task = await taskResponse.json();

  // Create recurrence pattern
  const recurrenceUrl = `http://localhost:3500/v1.0/invoke/recurrence-service/method/api/recurrence/patterns`;

  const recurrenceResponse = await fetch(recurrenceUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${userId}`
    },
    body: JSON.stringify({
      task_id: task.id,
      ...args.recurrence
    })
  });

  return await recurrenceResponse.json();
}
```

