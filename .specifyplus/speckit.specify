## MCP Tools Extensions

### REQ-013: New MCP Tools

priority: medium
category: "AI Integration"
epic: "Advanced Features"

description: |
  Extend MCP server with new tools for advanced task management features.

new_tools:
  - name: "add_recurring_task"
    description: "Create a task with recurrence pattern"
    parameters:
      - title: string
      - description: string (optional)
      - priority: enum (low, medium, high, critical)
      - recurrence_pattern: object
        - frequency: enum (daily, weekly, monthly, custom)
        - interval: integer (e.g., every 2 days)
        - end_date: ISO 8601 timestamp (optional)
        - max_occurrences: integer (optional)

  - name: "set_due_date"
    description: "Set due date and reminder for a task"
    parameters:
      - task_id: integer
      - due_date: ISO 8601 timestamp
      - reminder_schedule: array of reminder times (e.g., ["1h", "1d"])

  - name: "search_tasks"
    description: "Search tasks with filters"
    parameters:
      - query: string (search text)
      - status: enum (pending, completed) (optional)
      - priority: enum (low, medium, high, critical) (optional)
      - tags: array of strings (optional)
      - due_before: ISO 8601 timestamp (optional)
      - due_after: ISO 8601 timestamp (optional)

  - name: "add_tags"
    description: "Add tags to a task"
    parameters:
      - task_id: integer
      - tags: array of strings

  - name: "set_priority"
    description: "Set task priority"
    parameters:
      - task_id: integer
      - priority: enum (low, medium, high, critical)

